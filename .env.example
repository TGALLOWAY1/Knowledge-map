# Postgres connection (Neon/Supabase/local). See README for setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_map"

# Anthropic API key — used ONLY by server routes; never exposed client-side.
ANTHROPIC_API_KEY=""

# AI model configuration (optional overrides).
# Strong model: grading, module generation, briefs, deep dives.
AI_MODEL_STRONG="claude-opus-4-8"
# Light model: gap suggestions, alt text, and other simple generation (cost control).
AI_MODEL_LIGHT="claude-haiku-4-5"

# Where uploaded infographic images are stored on disk (local storage driver).
UPLOAD_DIR="./.data/uploads"

# Google Drive Inbox import (Path B) — optional, not required for MVP.
# GOOGLE_DRIVE_INBOX_FOLDER_ID=""
# GOOGLE_SERVICE_ACCOUNT_JSON=""
